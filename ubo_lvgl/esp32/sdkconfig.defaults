# Target-neutral defaults, shared by every supported board.
# Per-chip settings live in sdkconfig.defaults.<target>, which ESP-IDF appends
# automatically for each entry of SDKCONFIG_DEFAULTS. CONFIG_IDF_TARGET is
# deliberately NOT pinned here — run `idf.py set-target esp32c6` (Waveshare C6
# AMOLED) or `idf.py set-target esp32s3` (ESP32-S3-BOX-3) first.

# 16MB flash, QIO.
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

CONFIG_COMPILER_OPTIMIZATION_PERF=y

# 1kHz tick gives LVGL smooth ~ms timing.
CONFIG_FREERTOS_HZ=1000

# app_main runs board + renderer init; give it headroom.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
