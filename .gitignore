.DS_Store

# Sibling client repos. Each lives in its own independent GitHub repo
# (ubopod/ubo-{swift,kotlin}-{grpc,app[s]}) and is only present locally
# as a side-by-side checkout — never tracked by this parent repo.
ubo-swift-grpc/
ubo-swift-app/
ubo-kotlin-grpc/
ubo-kotlin-apps/

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
#  Usually these files are written by a python script from a template
#  before PyInstaller builds the exe, so as to inject date/other infos into it.
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
cover/
tests/**/results/**/*png
tests/**/results/**/*mismatch.jsonc
tests/**/results/**/*mismatch.hash

# Translations
*.mo
*.pot

# pyenv
.python-version

# Environments
.venv
*.dev.env
env/
venv/
ENV/
env.bak/
venv.bak/

# pyright
/typings/

# logs
*.log
*.log.[0-9]*

# headless-kivy
headless_kivy*.raw

# packer
scripts/packer/packer_cache/
scripts/packer/output-*

# hatch
ubo_app/_version.py

# grpc
/ubo_app/rpc/proto/ubo
/ubo_app/rpc/ubo_bindings/*
!/ubo_app/rpc/ubo_bindings/client.py
!/ubo_app/rpc/ubo_bindings/parent_version.py

/screenshots
/snapshots
/recordings

# Claude Code
.claude/
CLAUDE.md

# Pipecat
whisker.bin